# ================================================================
# GigShield Environment Variables
# Copy this to .env.local and fill in your values
# NEVER commit .env.local to git
# ================================================================

# IMPORTANT: Backend uses NON-prefixed vars, Frontend uses VITE_ prefix!
# VITE_ = exposed to frontend (public keys only)
# No prefix = backend only (keep secrets safe)

# ─── Twilio WhatsApp ─────────────────────────────────────────────
# Get these from: https://twilio.com → Messaging → Try it out
# Sandbox number works immediately (no approval needed)
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE=whatsapp:+14155238886

# ─── Supabase ────────────────────────────────────────────────────
# Get these from: https://supabase.com → Your Project → Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Frontend also needs these (with VITE_ prefix)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# ─── Razorpay (Optional) ────────────────────────────────────────
# Get these from: https://dashboard.razorpay.com → Settings → API Keys
# For testing, use Test mode keys (key_id starts with rzp_test_)
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
VITE_RAZORPAY_KEY_SECRET=your_razorpay_secret_here
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret_here

# ─── OpenWeather API (Optional) ──────────────────────────────────
VITE_OPENWEATHER_API_KEY=your_openweather_key_here

# ─── Anthropic API (Optional - Backend Only) ────────────────────
ANTHROPIC_API_KEY=your_anthropic_key_here

# ─── OAuth Configuration ────────────────────────────────────────
VITE_OAUTH_REDIRECT_URL=http://localhost:5173/auth/callback

# ─── Server Configuration ───────────────────────────────────────
PORT=3001

